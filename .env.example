# Copy to .env at the repository root. Never commit .env.
# SQLite is sufficient for local development; PostgreSQL is also supported:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/job
DATABASE_URL=sqlite:///./job.db
# Replace both placeholders with separate values from: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-local-signing-key
SESSION_SECRET_KEY=replace-with-a-different-random-local-session-key
ALGORITHM=HS256

# Required for Google sign-in and Gmail access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/auth/google/callback
FRONTEND_REDIRECT=http://localhost:5173/dashboard
SCOPES=openid https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/gmail.readonly

# Optional local classifier. No API keys supplied and no paid models enabled.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
CLASSIFIER_MODEL=qwen3:8b
CLASSIFIER_ALLOW_PAID=0
# A zero budget is explicit rules-only operation. Raise it (for example to 40)
# to enable model fallback; provider failures then stay pending for a later sync.
GMAIL_LLM_BUDGET_PER_SYNC=0
# Durable scanner limits. Run exactly one scan worker for the initial local-model
# deployment; it provides one global inference slot and fair bounded job slices.
GMAIL_MAX_MESSAGES=200
GMAIL_SYNC_CHUNK=10
GMAIL_FETCH_CONCURRENCY=4
GMAIL_SCAN_LEASE_SECONDS=120
GMAIL_SCAN_POLL_SECONDS=1
CLASSIFIER_TIMEOUT_SECONDS=30
CLASSIFIER_MAX_ATTEMPTS=3
CLASSIFIER_BATCH_SIZE=10
CLASSIFIER_STRICT_JSON=1
CLASSIFIER_DISABLE_THINKING=1
CLASSIFIER_EXCERPT_LENGTH=2500
# Generate with: python -c "import base64; from cryptography.hazmat.primitives.ciphers.aead import AESGCM; print(base64.urlsafe_b64encode(AESGCM.generate_key(bit_length=256)).decode())"
# Never reuse the signing/session secrets here. Losing this key loses encrypted data.
DATA_ENCRYPTION_KEY=replace-with-a-base64-encoded-256-bit-key
DATA_ENCRYPTION_KEY_ID=local-v1
